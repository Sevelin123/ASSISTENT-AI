# Скопируйте в .env или передайте через переменные окружения.
# Всё необязательно: без ключа ассистент работает на встроенном оффлайн-NLU.
# API-КЛЮЧ НЕ ОБЯЗАТЕЛЕН. Ollama тоже работает без ключа.
# Облачный ключ создаётся только в вашем личном кабинете провайдера.
# Ключ из Arena — внутренний ключ сессии: НЕ извлекается и НЕ используется здесь.
# Умный режим без ключа: локальная Ollama ищется автоматически при старте.
# JARVIS_AUTO_LOCAL_LLM=1
# 403 Forbidden = провайдер запретил доступ к внешней модели, а не ошибка ядра.
# Отключить внешнюю модель и вернуться к оффлайн-NLU: JARVIS_LLM_ENABLED=0

# ── Сервер ──────────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080

# ── Мозг: OpenAI / Groq / OpenRouter / Together / LM Studio ──
# JARVIS_API_KEY=sk-...
# JARVIS_BASE_URL=https://api.openai.com/v1
# JARVIS_MODEL=gpt-4o-mini

# ── Мозг: локальная Ollama (ключ не нужен) ───────────────────
# ollama pull llama3.1 && ollama serve
# JARVIS_BASE_URL=http://localhost:11434/v1
# JARVIS_MODEL=llama3.1
# JARVIS_LLM_ENABLED=1

# ── Агент на вашем ПК ────────────────────────────────────────
JARVIS_AGENT_TOKEN=jarvis-local-agent
# JARVIS_SERVER=https://ваш-адрес.e2b.app

# ── Безопасность (по умолчанию ВЫКЛЮЧЕНО) ────────────────────
# JARVIS_ALLOW_SHELL=0
# JARVIS_ALLOW_POWER=0
# JARVIS_REQUIRE_CONFIRM=1
# JARVIS_SANDBOX_ROOT=/home/user
